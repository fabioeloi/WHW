{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fabioeloi/WHW/blob/main/docs/what/config.schema.json",
  "title": "WHW config (whw.config.json)",
  "type": "object",
  "properties": {
    "project": { "type": "string" },
    "dirs": {
      "type": "object",
      "properties": {
        "planning": { "type": "string", "default": "planning" },
        "adr": { "type": "string", "default": "docs/adr" },
        "plan": { "type": "string", "default": "docs/plan.md" },
        "checkpoints": { "type": "string", "default": ".whw/checkpoints" },
        "state": { "type": "string", "default": ".whw/state.db" },
        "roles": { "type": "string", "default": "roles" },
        "templates": { "type": "string", "default": "templates" },
        "skills": { "type": "string", "default": "skills" }
      },
      "additionalProperties": false
    },
    "gates": {
      "type": "object",
      "properties": {
        "tiers": {
          "type": "object",
          "additionalProperties": { "type": "array", "items": { "type": "string" } }
        },
        "custom": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "command"],
            "properties": {
              "name": { "type": "string" },
              "command": { "type": "string" },
              "description": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "evaluate": {
      "type": "object",
      "properties": {
        "phaseA": { "type": "array", "items": { "type": "string" } },
        "threshold": { "type": "number", "default": 3.5 },
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "weight"],
            "properties": {
              "id": { "type": "string" },
              "weight": { "type": "number" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "conventions": {
      "type": "object",
      "properties": {
        "branch": { "type": "string" },
        "commit": { "type": "string" },
        "waveLetters": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "adapters": {
      "type": "object",
      "properties": {
        "tools": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "runners": {
      "type": "object",
      "properties": {
        "default": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "escalation": {
      "type": "object",
      "properties": {
        "maxFailuresDefault": { "type": "number", "default": 2 },
        "tiers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "runner": { "type": "string" },
              "maxFailures": { "type": "number" },
              "human": { "type": "boolean" },
              "model": { "type": "string" },
              "costClass": { "type": "string", "description": "open-weight | closed | human (documentary)" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "process": {
      "type": "object",
      "description": "Delivery profile. classic (default) keeps the A–E contract. shift-left is opt-in and routes each wave by declared signals.",
      "properties": {
        "profile": { "enum": ["classic", "shift-left"], "default": "classic" },
        "signals": {
          "type": "array",
          "description": "Optional default signals for whw wave new when --signals is omitted. A shift-left wave still needs a non-empty set.",
          "items": {
            "enum": [
              "docs", "local-refactor", "test-only",
              "behavior", "schema", "new-module",
              "auth", "payment", "pii", "infra", "logging",
              "architecture", "security-boundary", "destructive-migration", "blast-radius"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "fitness": {
      "type": "array",
      "description": "Project-specific executable architecture checks. WHW does not ship universal domain rules.",
      "items": {
        "type": "object",
        "required": ["id", "command"],
        "properties": {
          "id": { "type": "string" },
          "command": { "type": "string" },
          "description": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "hooks": {
      "type": "object",
      "description": "Optional post-event shell commands. Non-zero exit is logged; the transition is not rolled back. Same trust bar as custom gates.",
      "properties": {
        "on_claim": { "type": "string", "description": "After a successful claim (status actually changed)" },
        "on_done": { "type": "string", "description": "After a successful done (status actually changed)" },
        "on_gate_fail": { "type": "string", "description": "After any gate run that produced a NO_GO (including unsynced-state)" },
        "on_close": { "type": "string", "description": "After a successful canonical close (not already-closed)" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
